/* 自定义标题栏样式 */
QMainWindow{
    background: transparent;
    padding: 0px;
    font-size: 14px;
}
QWidget{
    margin:0px;
    padding:0px;
}

QWidget#centralWidget{
    background-color: rgba(17, 24, 39, 1);
    margin: 0px;
    padding: 0px;
   /* border-radius:15px;*/
}

QSplitter#mainSplitter {
    margin: 0px;
    padding: 0px;
    width: 0px;

}

/* width水平分割器的手柄宽度 */
/* height垂直分割器的手柄高度 */

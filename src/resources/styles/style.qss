QPushButton#settingPushButton,
QPushButton#importPushButton,
QPushButton#exportPushButton
{
   border-radius: 6px;
   width:36px;
   height:36px;
   padding:0px;
   margin:0px;
   background:rgba(55,65,81,1);

}

QPushButton#settingPushButton:hover,
QPushButton#importPushButton:hover,
QPushButton#exportPushButton:hover {
    background: rgba(171, 83, 255, 1); /* 明显的背景色变化 */
    /*border: 1px solid rgba(194, 130, 255, 1);*/
    box-shadow: 0px 4px 12px rgba(147, 51, 234, 0.3); /* 增强的阴影效果 */
}


QPushButton[class="left-menu-btn"]{
    color: rgb(209, 213, 219);
    height:40px;
    text-align: left;
    padding-left:10px;
    padding-right:10px;
    background-color: rgba(31,41,55,1);
    border:none;

}

QPushButton[class="left-menu-btn"]::icon{
    padding-left:0px;
    padding-right:0px;
    margin-right:20px;

}

QPushButton[class="left-menu-btn"]:hover{
    background-color: rgba(147, 51, 234, 1);

}

QPushButton[class="left-menu-btn-selected"]{
    font-weight:bold;
    height: 30px;
    min-width:100px;
    background-color: rgba(147, 51, 234, 1);
    border-radius: 16px;

}











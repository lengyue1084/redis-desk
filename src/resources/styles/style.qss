       background-color: #cccccc;
       width: 1px;
       height: 1px;
       border: 1px solid #ffffff;
       border-radius: 3px;
       margin: 0px;
   }*/

   /* 手柄悬停效果 */
/*   QSplitter#mainSplitter::handle:hover {
       background-color: #3498db;
       border-color: #2980b9;
   }*/

   /* 手柄按下效果 */
/*   QSplitter#mainSplitter::handle:pressed {
       background-color: #2980b9;
   }*/



QWidget#leftContentQidget{
    background-color: rgba(31,41,55,1);
    margin: 0px;
    padding: 0px;
    color:rgb(156, 163, 175);

}

QWidget#leftopWidget{
/*    color:rgb(156, 163, 175);*/
    margin:0px;
    padding:0px;

}

QLabel#titleLabel{
   font-size: 24px;
   line-height: 32px;
   font-weight:700;
   color: rgba(168,85,247,1);

}

QPushButton#connectNewPushButton{
   height: 30px;
   min-width:100px;
   background: rgba(147, 51, 234, 1);
   border-radius: 6px;
   color: #ffffff;
   padding: 3px 0px;
   text-align: center;
   margin: 0px;
   qproperty-iconSpacing: 8px; /* 设置图标与文字间距 */
}

QPushButton#connectNewPushButton:hover {
    background: rgba(171, 83, 255, 1); /* 明显的背景色变化 */
    border: 1px solid rgba(194, 130, 255, 1); /* 边框颜色变化 */
    box-shadow: 0px 4px 12px rgba(147, 51, 234, 0.3); /* 增强的阴影效果 */
}

QLabel[class="title-white"]{
   color:rgba(156,163,175,1);
   font-size:14px;
   font-weight:500;
}

QListView#connectListView{
   padding:0px;
   margin:0px;
   background-color: rgba(31,41,55,1);
   color:rgb(156, 163, 175);
   border:none;
}

/* 单个项目样式 */
QListView#connectListView::item {
    min-height: 40px;
    width:100%;
    padding: 0px;
    margin: 0px;
    border: 0px solid transparent;
    border-radius: 6px;
    background: red;
    font-size:16px;
}

/* 鼠标悬停效果 */
QListView#connectListView::item:hover {
/*    background-color: #e8f4ff;*/
    border: 0px solid #b3d9ff;
    background-color: red;
}

/* 选中状态 */
QListView#connectListView::item:selected {
/*    background-color: #374151;*/
    border: 0px solid #374151;
    color: white;
    background:red;
}

/* 选中但未激活状态 */
/*QListView#connectListView::item:selected:!active {
    background-color: #374151;
    color: #333;
}*/

/* 交替行颜色 */
QListView#connectListView::item:alternate {
    background-color: #374151;
}

/* 禁用状态 */
QListView#connectListView::item:disabled {
    color: #999;
    background-color: #f0f0f0;
}

/* 滚动条样式 */
QScrollBar#connectListView:vertical {
    border: none;
    background: #374151;
    width: 10px;
    margin: 0px;
}

QScrollBar#connectListView::handle:vertical {
    background: #c1c1c1;
    border-radius: 5px;
    min-height: 30px;
}

/*QScrollBar::handle:vertical:hover {
    background: #a8a8a8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}*/

